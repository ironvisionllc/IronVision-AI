[Unit]
Description=IronVision AI (docker compose, production)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ironvision/app
# compose.env (COMPOSE_PROJECT_NAME / COMPOSE_FILE / COMPOSE_PROFILES) is written by scripts/deploy.sh: same overlays as the deploy
EnvironmentFile=/srv/ironvision/compose.env
Environment=COMPOSE="docker compose --env-file deploy/digitalocean/.env.production"
ExecStartPre=/usr/bin/python3 scripts/check_env.py deploy/digitalocean/.env.production
ExecStart=/bin/sh -c '$COMPOSE up -d'
ExecStop=/bin/sh -c '$COMPOSE stop'
TimeoutStartSec=600
User=ironvision
Group=docker

[Install]
WantedBy=multi-user.target
