# IronVision AI – STAGING env template (synthetic demo data only). Copy to deploy/digitalocean/.env.staging (chmod 600).
# Validate: python3 scripts/check_env.py deploy/digitalocean/.env.staging     STATUS: not yet executed on DigitalOcean.
# demo = the public demo deployment (Explore-the-demo allowed); customer = customer production (never demo login)
DEPLOYMENT_KIND=demo
APP_ENV=staging
APP_DOMAIN=staging.app.example.gov
DATA_ROOT=/srv/ironvision-staging
FRONTEND_URL=https://staging.app.example.gov
CORS_ORIGINS=https://staging.app.example.gov
# ---- TLS (edge nginx) ----
# Let's Encrypt account e-mail (expiry notices). ./deploy.sh --set-domain <domain> --email <you@org> sets it.
LETSENCRYPT_EMAIL=
# true = Let's Encrypt STAGING CA (untrusted certificate, no rate limits) – for test runs only
LETSENCRYPT_STAGING=false
# optional: your own certificate instead of Let's Encrypt (PEM files on the Droplet; copied into DATA_ROOT/letsencrypt/live/<domain>/)
CERT_FULLCHAIN_PATH=
CERT_KEY_PATH=
REACT_APP_BACKEND_URL=
REACT_APP_ENV_LABEL=staging
LOG_LEVEL=INFO

POSTGRES_DB=ironvision_staging
POSTGRES_USER=ironvision
POSTGRES_PASSWORD=
# ---- object storage (MinIO was removed: its community images are no longer published) ----
# Profile A (default): self-hosted SeaweedFS on Block Storage (${DATA_ROOT}/objectstore), internal network only.
COMPOSE_PROFILES=seaweedfs
# Images pinned by digest (multi-arch index digest, verified against the registry; preflight compares the running image).
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d
POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
EDGE_NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
CERTBOT_IMAGE=certbot/certbot:v2.11.0@sha256:ddf9e5d226a56e886986838fa0ebedc0237511c78664352e8d0f4346ee022cd8
KEYCLOAK_BASE_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024
STORAGE_DRIVER=s3
S3_BUCKET=ironvision-staging-evidence
S3_REGION=us-east-1
# empty = bundled SeaweedFS (http://seaweedfs:8333). DO Spaces: https://nyc3.digitaloceanspaces.com (+ S3_ADDRESSING_STYLE=virtual,
# remove COMPOSE_PROFILES). AWS S3: https://s3.<region>.amazonaws.com. Garage: http://garage:3900 (see guide "Storage profiles").
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=path
# application identity (least privilege: read/write/list on S3_BUCKET only) – generate: openssl rand -hex 16 / openssl rand -base64 30
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# SeaweedFS admin identity (bucket bootstrap only; must differ from the app key). Not needed for Spaces/AWS.
S3_ADMIN_ACCESS_KEY_ID=
S3_ADMIN_SECRET_ACCESS_KEY=
S3_BUCKET_VERSIONING=true
S3_BUCKET_POLICY_FILE=
# objectstore-init: seconds to wait for the S3 endpoint to accept connections
S3_BOOTSTRAP_WAIT_SECONDS=90
# Profile D: STORAGE_DRIVER=local stores evidence under ${DATA_ROOT}/objects (compose mounts it at /srv/objects; leave empty here).
STORAGE_LOCAL_ROOT=
# Off-droplet backup copy (any S3: DO Spaces / AWS S3) – used by deploy/digitalocean/backup-offsite.sh via objsync
OFFSITE_S3_ENDPOINT_URL=
OFFSITE_S3_BUCKET=
OFFSITE_S3_REGION=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_S3_ADDRESSING_STYLE=virtual

# Synthetic demo accounts with a GENERATED password (never the documented AegisDemo!2026):
SEED_DEMO_DATA=true
# Single shared demo account demo@ironvision.ai (staging: STAGING_DEMO_PASSWORD wins); self sign-up creates private sandbox tenants
DEMO_PASSWORD=
ALLOW_SIGNUP=true
# "Explore the demo" button: passwordless session for the shared demo account (rate limit DEMO_LOGIN_RATE_LIMIT, default 30/3600 per IP)
ALLOW_DEMO_LOGIN=true
DEMO_LOGIN_RATE_LIMIT=30/3600
SANDBOX_INACTIVITY_DAYS=30
# sign-ups per client IP per window (count/seconds); client IP = X-Forwarded-For only when the peer is a trusted proxy
SIGNUP_RATE_LIMIT=5/3600
# optional: exact CI/test-runner egress addresses (/32) that bypass the sign-up limit; never broad public ranges
SIGNUP_RATE_LIMIT_EXEMPT_CIDRS=
# bot check: minimum seconds between loading the sign-up form and submitting it
SIGNUP_MIN_SECONDS=2
TRUSTED_PROXIES=172.16.0.0/12
STAGING_DEMO_PASSWORD=
DEMO_USER_PASSWORD=
AUTH_PROVIDERS=dev_password
DEV_USER_PICKER=false
# Set when the edge protects the host (check_env warns if the picker is exposed without them):
STAGING_BASIC_AUTH_HTPASSWD=/srv/ironvision-staging/staging/htpasswd
STAGING_ALLOW_CIDRS=203.0.113.0/24

JWT_SECRET=
JWT_TTL_MINUTES=60
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid profile email"
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_ALLOWED_ALGS=RS256,ES256
OIDC_POST_LOGOUT_REDIRECT_URI=
# Dev/test only: link an unmapped IdP identity by e-mail (ignored outside development/test). Keep false.
OIDC_ALLOW_EMAIL_LINKING=false
# ---- Built-in Keycloak (docs/KEYCLOAK.md). Leave AUTH_DOMAIN empty to use an external IdP (or none).
# ./deploy.sh --set-auth-domain auth.<your-domain> fills AUTH_DOMAIN / OIDC_* ; gen_env_secrets fills the empty secrets below.
# AUTH_PROVIDERS is NOT switched automatically – change it to oidc only after keycloak-migrate (docs/KEYCLOAK.md §6).
AUTH_DOMAIN=
KEYCLOAK_REALM=ironvision-demo
KEYCLOAK_REALM_DISPLAY_NAME="IronVision AI"
KEYCLOAK_REQUIRE_MFA=false
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
# optional: role allowed to CREATE ROLE/DATABASE if DATABASE_URL's role is not (default: DATABASE_URL)
KEYCLOAK_DB_INIT_URL=
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# named permanent master-realm admin (OTP enrolment forced at first login); bootstrap admin is disabled after first apply
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CONFIGURATOR_CLIENT_ID=ironvision-configurator
KEYCLOAK_CONFIGURATOR_CLIENT_SECRET=
# public admin console allowlist on AUTH_DOMAIN (comma CIDRs). Empty = denied → SSH tunnel to 127.0.0.1:8081 only
KEYCLOAK_ADMIN_ALLOWED_CIDRS=
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_URL=http://keycloak:8080
AUTH_CERT_FULLCHAIN_PATH=
AUTH_CERT_KEY_PATH=
CREDENTIALS_DIR=/srv/ironvision/secrets
# ---- Explore-the-demo launcher (docs/KEYCLOAK.md §7): server-side password grant on a client restricted to the demo user
# unpublished Keycloak handle of the launcher user (generated; never the public demo e-mail)
KEYCLOAK_DEMO_USERNAME=
KEYCLOAK_DEMO_PASSWORD=
KEYCLOAK_DEMO_LAUNCHER_CLIENT_ID=ironvision-demo-launcher
KEYCLOAK_DEMO_LAUNCHER_CLIENT_SECRET=
# Keycloak self-registration (realm ironvision-demo, DEPLOYMENT_KIND=demo ONLY – check_env refuses it elsewhere): new registrants
# get a clean private sandbox just-in-time; existing app e-mails are refused, never linked. No e-mail verification (no SMTP).
KEYCLOAK_ALLOW_REGISTRATION=true
KEYCLOAK_BACKEND_CLIENT_ID=ironvision-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=
DEMO_LOGIN_GLOBAL_RATE_LIMIT=300/3600
MTLS_TRUSTED_PROXIES=
MTLS_HEADER_VERIFY=x-ssl-client-verify
MTLS_HEADER_DN=x-ssl-client-s-dn
MTLS_HEADER_EDIPI=x-client-edipi

TRUST_PROXY_HEADERS=true
HSTS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20/60
RATE_LIMIT_UPLOAD=30/60
MAX_UPLOAD_MB=50
UPLOAD_SCANNER=none
CONTENT_SECURITY_POLICY=

SECRET_STORE_BACKEND=env_key
SECRET_STORE_KEY=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=aegisrmf

# ---- AI ----
# none | openrouter (one key, any model – recommended) | anthropic | openai_compatible (vLLM / Ollama / gateway)
AI_PROVIDER=none
# any model slug, passed through verbatim (OpenRouter: openai/gpt-4.1, openai/gpt-4o, anthropic/claude-3.5-sonnet,
# meta-llama/llama-3.1-70b-instruct, mistralai/mistral-large …). The AI administration page can override it.
AI_MODEL=
# optional per-use-case models (fall back to AI_MODEL)
AI_MODEL_DRAFTING=
AI_MODEL_POLICY=
AI_MODEL_MAPPING=
AI_MODEL_SUMMARY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
# openrouter / openai_compatible: OPENAI_COMPAT_API_KEY is the only key. openrouter: base URL defaults to https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# optional OpenRouter attribution headers (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME="IronVision AI"
# only for AI_PROVIDER=anthropic (never read with openrouter)
ANTHROPIC_API_KEY=

WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_STALE_SECONDS=30
SCHEDULER_TICK_SECONDS=30
CONTENT_FETCH_REMOTE=false
ALLOW_INSECURE_PRODUCTION=false

BACKUP_DIR=/srv/ironvision-staging/backups
BACKUP_RETENTION_DAYS=7

