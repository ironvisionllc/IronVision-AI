# AegisRMF worker – shares the backend codebase (backend/worker/). Same variables as backend/.env.example, plus:
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@127.0.0.1:5432/aegisrmf
JWT_SECRET=generate-with-openssl-rand-hex-32
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
CONTENT_DIR=./content
CONTENT_FETCH_REMOTE=false
LOG_LEVEL=INFO
WORKER_ID=
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_STALE_SECONDS=30
