# AegisRMF backend API – copy to backend/.env for local (non-Docker) development.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 16 (SQLAlchemy URL, psycopg3 driver)
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@127.0.0.1:5432/aegisrmf
# Disposable DB used (and WIPED) by pytest
TEST_DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@127.0.0.1:5432/aegisrmf_test

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth (AUTH_PROVIDER = identity store for the dev picker; AUTH_PROVIDERS = enabled sign-in methods: dev_password,oidc,mtls_header)
AUTH_PROVIDER=dev_password
AUTH_PROVIDERS=dev_password
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_TTL_MINUTES=60
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD="AegisDemo!2026"

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI: anthropic | openai_compatible | emergent (DEV ONLY) | none
# ---- AI ----
# none | openrouter (one key, any model – recommended) | anthropic | openai_compatible (vLLM / Ollama / gateway)
AI_PROVIDER=anthropic
# any model slug, passed through verbatim (OpenRouter: openai/gpt-4.1, openai/gpt-4o, anthropic/claude-3.5-sonnet,
# meta-llama/llama-3.1-70b-instruct, mistralai/mistral-large …). The AI administration page can override it.
AI_MODEL=claude-sonnet-5-5
# optional per-use-case models (fall back to AI_MODEL)
AI_MODEL_DRAFTING=
AI_MODEL_POLICY=
AI_MODEL_MAPPING=
AI_MODEL_SUMMARY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=
# openrouter / openai_compatible: OPENAI_COMPAT_API_KEY is the only key. openrouter: base URL defaults to https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# optional OpenRouter attribution headers (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME="IronVision AI"
# only for AI_PROVIDER=anthropic (never read with openrouter)
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=

# Reference content (vendored + SHA-256 verified). true = re-download from pinned URL and verify hash.
CONTENT_DIR=./content
CONTENT_FETCH_REMOTE=false

# Phase 1
SECRET_STORE_KEY=
SAMPLES_DIR=../samples
SCHEDULER_TICK_SECONDS=30

# Phase 5 hardening
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20/60
RATE_LIMIT_UPLOAD=30/60
TRUST_PROXY_HEADERS=false
HSTS_ENABLED=true
MAX_UPLOAD_MB=50
UPLOAD_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FRONTEND_URL=http://localhost:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8001/api/v1/auth/oidc/callback
OIDC_SCOPES="openid profile email"
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_ALLOWED_ALGS=RS256,ES256
MTLS_TRUSTED_PROXIES=
MTLS_HEADER_VERIFY=x-ssl-client-verify
MTLS_HEADER_DN=x-ssl-client-s-dn
MTLS_HEADER_EDIPI=x-client-edipi
SECRET_STORE_BACKEND=env_key
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=aegisrmf
