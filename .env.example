# docker compose environment – copy to .env at repo root (scripts/verify_portability.sh does this for you).
POSTGRES_DB=aegisrmf
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-postgres

# Object storage: bundled SeaweedFS S3 (MinIO removed – community images are no longer published).
# External S3 instead (DO Spaces / AWS / Garage): clear COMPOSE_PROFILES and set S3_ENDPOINT_URL + keys. Or STORAGE_DRIVER=local.
COMPOSE_PROFILES=seaweedfs
STORAGE_DRIVER=s3
S3_BUCKET=aegisrmf
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=aegisapp
S3_SECRET_ACCESS_KEY=change-me-app-s3-secret
S3_ADMIN_ACCESS_KEY_ID=aegisadmin
S3_ADMIN_SECRET_ACCESS_KEY=change-me-admin-s3-secret

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_TTL_MINUTES=60
DEMO_USER_PASSWORD="AegisDemo!2026"
CORS_ORIGINS=http://localhost:3000

# anthropic | openai_compatible | none   (emergent is DEV ONLY and not installed in images)
# ---- AI ----
# none | openrouter (one key, any model – recommended) | anthropic | openai_compatible (vLLM / Ollama / gateway)
AI_PROVIDER=none
# any model slug, passed through verbatim (OpenRouter: openai/gpt-4.1, openai/gpt-4o, anthropic/claude-3.5-sonnet,
# meta-llama/llama-3.1-70b-instruct, mistralai/mistral-large …). The AI administration page can override it.
AI_MODEL=claude-sonnet-5-5
# optional per-use-case models (fall back to AI_MODEL)
AI_MODEL_DRAFTING=
AI_MODEL_POLICY=
AI_MODEL_MAPPING=
AI_MODEL_SUMMARY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
# openrouter / openai_compatible: OPENAI_COMPAT_API_KEY is the only key. openrouter: base URL defaults to https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# optional OpenRouter attribution headers (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME="IronVision AI"
# only for AI_PROVIDER=anthropic (never read with openrouter)
ANTHROPIC_API_KEY=

# Empty = same-origin (/api proxied by frontend nginx)
REACT_APP_BACKEND_URL=
LOG_LEVEL=INFO
# Fernet key for connector credentials: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=

# ---- Phase 5 hardening ----
# Comma list of: dev_password | oidc | mtls_header   (docker-compose.prod.yml defaults to oidc; dev_password must never be on in production)
AUTH_PROVIDERS=dev_password
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20/60
RATE_LIMIT_UPLOAD=30/60
TRUST_PROXY_HEADERS=false
MAX_UPLOAD_MB=50
# none | clamav  (clamav requires: docker compose --profile clamav up)
UPLOAD_SCANNER=none
FRONTEND_URL=http://localhost:3000
# OIDC (Keycloak dev profile: OIDC_ISSUER=http://localhost:8081/realms/aegisrmf, OIDC_CLIENT_ID=aegisrmf)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_SCOPES="openid profile email"
# CAC/PIV via TLS-terminating proxy (header stub); comma list of proxy IPs
MTLS_TRUSTED_PROXIES=
# env_key | vault
SECRET_STORE_BACKEND=env_key
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# optional profiles
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
